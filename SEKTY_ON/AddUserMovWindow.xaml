<Window x:Class="SEKTY_ON.AddUserMovWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Registrar Usuario" 
        Height="450" Width="400" 
        WindowStartupLocation="CenterScreen" 
        ResizeMode="NoResize"
        Background="White">

    <Window.Resources>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style x:Key="RoundedInputStyle" TargetType="Control">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Control">
                        <Border CornerRadius="8" Background="White" BorderBrush="#CCCCCC" BorderThickness="1" Padding="8,0">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <StackPanel Margin="30,15,30,15">

            <TextBlock Text="Nuevo Usuario Móvil" 
                       FontSize="22" 
                       FontWeight="ExtraBold" 
                       Foreground="#660636" 
                       HorizontalAlignment="Center" 
                       Margin="0,0,0,20"/>

            <TextBlock Text="Nombre Completo" Style="{StaticResource LabelStyle}"/>
            <TextBox x:Name="txtNombre" Style="{StaticResource RoundedInputStyle}"/>

            <TextBlock Text="Contraseña" Style="{StaticResource LabelStyle}"/>
            <PasswordBox x:Name="txtPassword" Style="{StaticResource RoundedInputStyle}"/>

            <StackPanel Margin="0,5,0,0">
                <Button x:Name="btnGuardar" 
                        Content="GUARDAR REGISTRO" 
                        Click="btnGuardar_Click" 
                        Background="#660636" 
                        Foreground="White" 
                        FontSize="14"
                        FontWeight="Bold"
                        Height="48" 
                        Margin="0,0,0,10" 
                        Cursor="Hand"
                        BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="10"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button x:Name="btnCancelar" 
                        Content="Regresar / Cancelar" 
                        Click="btnCancelar_Click" 
                        Background="#F0F0F0" 
                        Foreground="#660636" 
                        FontSize="13"
                        Height="35" 
                        Cursor="Hand"
                        BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="10"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>