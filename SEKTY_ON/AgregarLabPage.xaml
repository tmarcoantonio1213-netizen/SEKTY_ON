<Page x:Class="SEKTY_ON.AgregarLabPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:SEKTY_ON"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AgregarLabPage">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
            Background="White">

            <Label
                Background="White"
                Content="Asignación de Laboratorios"
                Foreground="Black"
                FontSize="40" FontFamily="/Desing/Fonts/#Kikuta Thin"
                HorizontalAlignment="Center" VerticalAlignment="Center"/>

        </StackPanel>

        <Grid Grid.Row="1" Background="Gray">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="White"
                    Height="560" Width="650"
                    Margin="20,0,0,0"
                    CornerRadius="20" BorderThickness="0"
                    ClipToBounds="True">

                <StackPanel>

                    <TextBlock
                        Width="498"
                        TextWrapping="Wrap"
                        Text="Llena los siguientes campos"
                        FontSize="40" Foreground="#660636" FontFamily="/Desing/Fonts/#BBB Poppins TN Text Black"
                        HorizontalAlignment="Left"
                        Margin="55,30,0,45"/>

                    <TextBlock
                        Text="Nombre del Laboratorio:"
                        FontSize="20"
                        HorizontalAlignment="Left"
                        Margin="55,0,0,0"/>
                    <Border Background="#D9D9D9" 
                            Height="60" 
                            Margin="45,0,45,45" 
                            CornerRadius="10" BorderThickness="0"
                            ClipToBounds="True">

                        <StackPanel Orientation="Horizontal">
                            
                            <TextBox x:Name="txtNombreLab"
                                     Height="49" Width="520"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     FontSize="30"
                                     VerticalContentAlignment="Center"
                                     Margin="20,0,0,0"/>

                        </StackPanel>

                    </Border>

                    <TextBlock
                        Text="Edificio donde se ubica:"
                        FontSize="20"
                        HorizontalAlignment="Left"
                        Margin="55,0,0,0"/>
                    <Border Background="#D9D9D9" 
                            Height="60" 
                            Margin="45,0,45,0" 
                            CornerRadius="10" BorderThickness="0"
                            ClipToBounds="True">

                        <StackPanel Orientation="Horizontal">

                            <TextBox x:Name="txtEdificio"
                                     Height="49" Width="520"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     FontSize="30"
                                     VerticalContentAlignment="Center"
                                     Margin="20,0,0,0"/>

                        </StackPanel>

                    </Border>

                    <DockPanel>
                        <Button x:Name="btnAgregarLab"
                                Click="btnAgregarLab_Click"
                                Height="70"
                                Background="#660636"
                                BorderThickness="0"
                                Content="Agregar nuevo Laboratorio"
                                FontSize="35" Foreground="White" FontFamily="/Desing/Fonts/#kikuta Thin"
                                VerticalAlignment="Center"
                                Margin="45,75,45,0">

                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="borderRedondo"
                                            Background="{TemplateBinding Background}"
                                            CornerRadius="10" 
                                            BorderThickness="0"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="borderRedondo" Property="Opacity" Value="0.8"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DockPanel>

                </StackPanel>

            </Border>

        </Grid>

    </Grid>
</Page>
