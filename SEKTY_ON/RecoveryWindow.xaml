<Window x:Class="SEKTY_ON.RecoveryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Recuperar Contraseña" Height="450" Width="400"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True" WindowStyle="None" Background="Transparent">

    <Border Background="White" CornerRadius="30" BorderBrush="#660636" BorderThickness="3">
        <Grid Margin="20">
            <StackPanel VerticalAlignment="Center">

                <TextBlock Text="SEKTY-ON" FontSize="40" FontWeight="Bold" 
                           Foreground="#660636" HorizontalAlignment="Center" Margin="0,0,0,10"/>

                <TextBlock Text="Recuperar Acceso" FontSize="20" 
                           Foreground="Gray" HorizontalAlignment="Center" Margin="0,0,0,30"/>

                <TextBlock Text="Introduce tu correo registrado:" FontSize="14" 
                           Foreground="#660636" Margin="10,0,0,5"/>

                <Border Background="#F0F0F0" CornerRadius="10" Height="45" Margin="0,0,0,20">
                    <TextBox x:Name="txtCorreoRecuperar" 
                             VerticalContentAlignment="Center"
                             Padding="10,0" FontSize="16" 
                             BorderThickness="0" Background="Transparent"/>
                </Border>

                <Button x:Name="btnValidar" Content="Verificar Correo" Height="45" 
                        Background="#660636" Foreground="White" FontSize="16" 
                        Cursor="Hand" Click="btnValidar_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="10"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button x:Name="btnRegresar" Content="Regresar al Login" Margin="0,15,0,0"
                        Background="Transparent" BorderThickness="0" Foreground="Gray" 
                        Cursor="Hand" Click="btnRegresar_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>