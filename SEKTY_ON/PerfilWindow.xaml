<Window x:Class="SEKTY_ON.PerfilWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SEKTY_ON"
        mc:Ignorable="d"
        WindowState="Maximized"
        Title="PerfilWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="70"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Column="0"
                   Background="#660636"
                   Height="200"
                   VerticalAlignment="Top">

            <TextBlock DockPanel.Dock="Right"
                       Text="Perfil de Usuario"
                       FontSize="80" FontFamily="/Desing/Fonts/#Kikuta Thin" Foreground="White"
                       VerticalAlignment="Bottom"
                       Margin="20,0,0,-10"/>

        </DockPanel>

        <Button Grid.Column="0" x:Name="btnFotoPerfil"
                Background="White"
                Height="225" Width="225"
                Margin="0,85,0,0">

            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="fondo"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="200">

                                    <Image
                                        Height="240" Width="240"
                                        Source="/Desing/Iconos/usuarioPerfil.png"
                                        VerticalAlignment="Center" HorizontalAlignment="Center"/>

                                </Border>
                                <ControlTemplate.Triggers>

                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Cursor" Value="Hand"/>
                                    </Trigger>

                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Button.Style>

        </Button>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="770"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        Orientation="Vertical">

                <Border
                    Background="#D9D9D9"
                    Height="60"
                    CornerRadius="10" BorderThickness="0"
                    ClipToBounds="True"
                    Margin="40,70,40,70">

                    <StackPanel Orientation="Horizontal">
                        <Image
                            Height="40" Width="40"
                            Source="/Desing/Iconos/avatarUsuario.png"
                            Margin="10,0,0,0"/>


                        <TextBox x:Name="txtUsername"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Height="50" Width="620"
                                 Text="{Binding Nombre}"
                                 FontSize="35"
                                 Margin="5,0,10,0"/>
                    </StackPanel>
                </Border>
                
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Vertical">

                <Border
                    Background="#D9D9D9"
                    Height="60"
                    CornerRadius="10" BorderThickness="0"
                    ClipToBounds="True"
                    Margin="40,70,40,70">

                    <StackPanel Orientation="Horizontal">
                        <Image
                            Height="35" Width="35"
                            Source="/Desing/Iconos/correoUsuario.png"
                            Margin="10,0,0,0"/>


                        <TextBox x:Name="txtCorreo"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Height="50" Width="620"
                                 Text="{Binding Correo}"
                                 FontSize="35"
                                 Margin="5,0,10,0"/>
                    </StackPanel>
                </Border>

            </StackPanel>
            
        </Grid>

        <DockPanel Grid.Row="2">
            
            <Border
                Background="#D9D9D9"
                Height="60" Width="690"
                CornerRadius="10" BorderThickness="0"
                ClipToBounds="True"
                VerticalAlignment="Top">

                <StackPanel Orientation="Horizontal">
                    <Image
                        Height="35" Width="35"
                        Source="/Desing/Iconos/llaveContraseña.png"
                        Margin="10,0,0,0"/>


                    <TextBlock x:Name="txtContraseña"
                               Background="Transparent"
                               Height="50" Width="620"
                               Text="********"
                               FontSize="35"
                               Margin="5,0,10,0"/>
                </StackPanel>
            </Border>
        </DockPanel>

        <DockPanel Grid.Row="3"
                   HorizontalAlignment="Right">
            <StackPanel Orientation="Horizontal">

                <Button x:Name="btnAtras"
                        Click="btnAtras_Click"
                        Height="55" Width="130"
                        Background="#a6a6a6"
                        Margin="0,0,20,0">

                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="fondo"
                                            Background="{TemplateBinding Background}"
                                            CornerRadius="10">

                                            <ContentPresenter
                                                HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                        </Border>

                                        <ControlTemplate.Triggers>

                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="fondo" Property="Background" Value="Gray"/>
                                            </Trigger>

                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>

                    <TextBlock
                        Text="Atrás"
                        FontSize="20" FontFamily="/Desing/Fonts/#Zx Gamut Bold" Foreground="White"/>

                </Button>

                <Button x:Name="btnActualizarDatos"
                        Click="btnActualizarDatos_Click"
                        Height="55" Width="180"
                        Background="#a6a6a6"
                        Margin="0,0,20,0">

                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="fondo"
                                                Background="{TemplateBinding Background}"
                                                CornerRadius="10">

                                            <ContentPresenter
                                                HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                        </Border>

                                        <ControlTemplate.Triggers>

                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="fondo" Property="Background" Value="Gray"/>
                                            </Trigger>

                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>

                    <TextBlock
                        Text="Actalizar Datos"
                        FontSize="20" FontFamily="/Desing/Fonts/#Zx Gamut Bold" Foreground="White"/>

                </Button>

                <Button x:Name="btnCerrarSesion"
                        Click="btnCerrarSesion_Click"
                        Height="55" Width="160"
                        Background="#660636"
                        
                        Margin="0,0,40,0">

                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="fondo"
                                                Background="{TemplateBinding Background}"
                                                CornerRadius="10">

                                            <ContentPresenter
                                                HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                        </Border>

                                        <ControlTemplate.Triggers>

                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="fondo" Property="Background" Value="#590a2a"/>
                                            </Trigger>

                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                    
                    <TextBlock
                        Text="Cerrar Sesión"
                        FontSize="20" FontFamily="/Desing/Fonts/#Zx Gamut Bold" Foreground="White"/>

                </Button>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
